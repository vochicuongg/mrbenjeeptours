{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mr. Ben Webhook Payload — Make.com",
  "description": "Schema chung cho 2 dịch vụ: Tour Xe Jeep & Xe Đưa Đón. Make.com dùng trường serviceType để phân nhánh.",
  "type": "object",
  "required": ["serviceType", "customerName", "phone", "vehicleType", "pickupDate", "pickupTime", "totalPrice", "createdAt"],
  "properties": {
    "serviceType": { "type": "string", "enum": ["Tour Xe Jeep", "Xe Đưa Đón"] },
    "customerName": { "type": "string", "minLength": 2 },
    "phone": { "type": "string", "description": "SĐT kèm mã quốc gia, VD: +84786220300" },
    "vehicleType": { "type": "string", "enum": ["Xe Jeep", "Xe 7 Chỗ Xăng", "Xe 7 Chỗ Điện", "Xe 16 Chỗ"] },
    "route": { "type": "string", "description": "Tuyến đường (Transfer) hoặc lộ trình tour (Jeep)" },
    "hotel": { "type": "string" },
    "address": { "type": "string" },
    "pickupDate": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "pickupTime": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
    "totalPrice": { "type": "string", "description": "VD: '1.900.000₫'" },
    "totalPriceRaw": { "type": "integer", "minimum": 0 },
    "notes": { "type": "string" },
    "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$" },
    "tourLine": { "type": "string", "description": "[Jeep only] VD: '04:30 - Tour Riêng Tư'" },
    "tourType": { "type": "string", "enum": ["Tour Riêng Tư", "Tour Ghép"] },
    "vehicleStr": { "type": "string", "description": "[Jeep only] VD: '2 xe'" },
    "addonSandDuneSelected": { "type": "boolean" },
    "addonStr": { "type": "string" },
    "finalRouteVi": { "type": "string" },
    "pickup": { "type": "string", "description": "[Jeep only] Điểm đón tùy chỉnh" },
    "holidaySurcharge": { "type": "boolean" },
    "pickupCity": { "type": "string", "description": "[Transfer only] Mã điểm đón: muine, sgn, nhatrang..." },
    "dropoffCity": { "type": "string", "description": "[Transfer only] Mã điểm trả" },
    "vehicleId": { "type": "string", "enum": ["gas7", "ev7", "gas16"] },
    "name": { "type": "string", "description": "[Legacy] = customerName" },
    "fullPhone": { "type": "string", "description": "[Legacy] = phone" },
    "hotelName": { "type": "string", "description": "[Legacy] = hotel" },
    "hotelAddr": { "type": "string", "description": "[Legacy] = address" },
    "dt": { "type": "string", "description": "[Legacy] DD-MM-YYYY | HH:mm" },
    "dtIso": { "type": "string", "description": "[Legacy] YYYY-MM-DD HH:mm" },
    "totalText": { "type": "string", "description": "[Legacy] = totalPrice" },
    "nowDt": { "type": "string", "description": "[Legacy] DD-MM-YYYY | HH:mm" }
  }
}
